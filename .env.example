# HTTP server (dashboard bind address)
APP_HOST=0.0.0.0
APP_PORT=8587

PUBLIC_BASE_URL=http://localhost:8587
DPR_QR_STORAGE_DIR=.\qr-codes

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=erp

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=28800

DPR_SSE_ENABLED=false
DPR_POLL_INTERVAL_MS=10000
HUB_PULSE_CACHE_SECONDS=300
HUB_SCHEMA_CACHE_SECONDS=600
REPORTS_SUMMARY_CACHE_SECONDS=30
PM_STATUS_CACHE_SECONDS=20

PM_ATTACHMENTS_DIR=.\pm-attachments
APP_DATA_DIR=.\data

# Operational data files (explicit for production/exe deployments)
RBAC_STORE_FILE=.\data\rbac.json
REPORTS_STORE_FILE=.\data\reports.json

# Waitress runtime tuning (used when APP_USE_DEV_SERVER is off)
WAITRESS_THREADS=12
WAITRESS_CONNECTION_LIMIT=1000
WAITRESS_CHANNEL_TIMEOUT=60
WAITRESS_CLEANUP_INTERVAL=30
