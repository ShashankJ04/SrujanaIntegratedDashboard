# Copy to `.env` in the project root and adjust values.
# Loaded by backend/config.py and run.py.

# ── ERP database ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=erp

# Connection pool (idle size + burst under parallel API load)
DB_POOL_SIZE=15
DB_POOL_MAX_OVERFLOW=15

# ── App server ──────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=5000
# APP_USE_DEV_SERVER=1

# Waitress (production via run.py)
# WAITRESS_THREADS=4
# WAITRESS_CONNECTION_LIMIT=200

# Tool Management daily schedule source:
#   scheduled_production  (default — from scheduled_production table)
#   production_calendar   — from Production Calendar day columns
# TOOL_SCHEDULE_SOURCE=scheduled_production

# Production scheduling — standard work hours per day (used by scheduler, production calendar, machine planning)
# WORK_HOURS_PER_DAY=6

# Soft capacity overflow per machine-day (minutes beyond nominal shift the scheduler may use)
# CAPACITY_OVERFLOW_MINUTES=30

# Inventory report — monthly snapshot at 23:59 on last day of month (sleep-until schedule, no polling)
# INVENTORY_SNAPSHOT_ENABLED=true
