# HTTP server (dashboard bind address)
APP_HOST=0.0.0.0
APP_PORT=5000

# Optional: 1 = Flask development server; omit or 0 = Waitress (recommended for exe/production)
# APP_USE_DEV_SERVER=0

# Optional Waitress thread pool (default 4)
# WAITRESS_THREADS=4

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=erp

# App (see backend/config.py for full list)
# TARGET_TABLE_NAME=vw_bharat_dashboard
# JWT_SECRET=change-me-in-production
# JWT_EXPIRES_IN=86400

# Dashboards (migrated from dashboards project)
PM_ATTACHMENTS_DIR=pm-attachments
